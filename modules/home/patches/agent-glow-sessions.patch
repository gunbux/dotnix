+def is_claude_binary(cmdline):
+    """argv[0] is Claude Code itself (claude, .claude-wrapped), not e.g. a shell
+    whose arguments merely mention ~/.claude."""
+    argv0 = os.path.basename(cmdline.split(" ", 1)[0]).lower()
+    return "claude" in argv0
+
+
+def newest_transcript(cwd):
+    """Most recently written transcript for a project dir. Claude Code names the
+    project folder after the cwd with every non-alphanumeric char as '-'."""
+    if not cwd:
+        return None
+    folder = os.path.join(CLAUDE_PROJECTS, re.sub(r"[^A-Za-z0-9]", "-", cwd))
+    try:
+        paths = glob.glob(os.path.join(folder, "*.jsonl"))
+        return max(paths, key=os.path.getmtime) if paths else None
+    except OSError:
+        return None
+
